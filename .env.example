# Kafka
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9091
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_USERNAME=your-kafka-username
KAFKA_PASSWORD=your-kafka-password
KAFKA_INPUT_TOPIC=your-input-topic
KAFKA_OUTPUT_TOPIC=your-output-topic

# PostgreSQL source: subscribers_restaurants
POSTGRES_SOURCE_URL=jdbc:postgresql://your-postgres-host:5432/your-database
POSTGRES_SOURCE_USER=your-source-user
POSTGRES_SOURCE_PASSWORD=your-source-password
POSTGRES_SOURCE_TABLE=subscribers_restaurants

# PostgreSQL target: feedback
POSTGRES_TARGET_URL=jdbc:postgresql://your-postgres-host:5432/your-database
POSTGRES_TARGET_USER=your-target-user
POSTGRES_TARGET_PASSWORD=your-target-password
POSTGRES_TARGET_TABLE=subscribers_feedback_s27040058
